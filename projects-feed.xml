---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} – Current Projects</title>
    <description>Current Missing Maps priority projects</description>
    <link>{{ site.url }}{{ site.baseurl }}/projects/</link>
    <atom:link href="{{ "/projects-feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.date | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% assign projects = site.projects | where: "feed.include_in_feed", true % | sort: "date" | reverse %}
{% for project in projects %}
  <item>
    <title>{{ project.title | xml_escape }}</title>
    <description>{{ project.feed.excerpt | default: "New Missing Maps mapping request." | xml_escape }}</description>
    <pubDate>{{ project.date | date_to_rfc822 }}</pubDate>
    <link>{{ project.external_url | xml_escape }}</link>
    <guid isPermaLink="false">{{ project.url | prepend: site.baseurl | prepend: site.url }}</guid>
    {% if project.category %}
    <category>{{ project.category | xml_escape }}</category>
    {% endif %}
  </item>
{% endfor %}
  </channel>
</rss>