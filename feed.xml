---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
 {% assign projects = site.projects | where: "feed.include_in_feed", true %}
 {% assign items = site.posts | concat: projects | sort: "date" | reverse %}
 {% for item in items limit:15 %}
      <item>
        <title>{{ item.title | xml_escape }}</title>
        {% if item.external_url %}
        <description>{{ item.feed.excerpt | default: "New Missing Maps mapping request." | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ item.external_url | xml_escape }}</link>
        <guid isPermaLink="false">{{ item.url | prepend: site.baseurl | prepend: site.url }}</guid>
        {% if item.category %}
        <category>{{ item.category | xml_escape }}</category>
        {% endif %}
        {% else %}
        <description>{{ item.excerpt | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ item.url | prepend: site.baseurl | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ item.url | prepend: site.baseurl | prepend: site.url }}</guid>
        {% for tag in item.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in item.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
        {% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>